---
import { Image } from 'astro:assets';
import Icon from '@/components/Icon.astro';
import PageHeader from '@/components/PageHeader.astro';
import Placeholder from '@/components/Placeholder.astro';
import Section from '@/components/Section.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { obtenerOrdenado } from '@/lib/contenido';

const iglesias = await obtenerOrdenado('iglesiasHijas');

const titulo = 'Iglesias hijas';
const descripcion =
  'Congregaciones plantadas por la iglesia: pastores, dirección, horarios y contacto de cada una.';
const migas = [
  { label: 'Obra misionera', href: '/obra-misionera' },
  { label: titulo, href: '/iglesias-hijas' },
];
---

<BaseLayout title={titulo} description={descripcion} migas={migas}>
  <PageHeader
    title={titulo}
    eyebrow="Plantación de iglesias"
    intro="Por la gracia de Dios, la iglesia ha dado a luz nuevas congregaciones. Conócelas y visítalas."
    migas={migas}
  />

  <Section tono="blanco">
    <div class="grid gap-8 md:grid-cols-2">
      {
        iglesias.map((iglesia) => (
          <a
            href={`/iglesias-hijas/${iglesia.id}`}
            class="group flex flex-col overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-sm transition hover:shadow-lg"
          >
            {iglesia.data.foto ? (
              <Image
                src={iglesia.data.foto}
                alt={`Fotografía de ${iglesia.data.nombre}`}
                class="aspect-[16/9] w-full object-cover"
                widths={[500, 1000]}
                sizes="(min-width: 768px) 50vw, 100vw"
              />
            ) : (
              <Placeholder icono="lucide:church" class="aspect-[16/9] w-full" />
            )}
            <div class="flex flex-1 flex-col p-6">
              <p class="eyebrow flex items-center gap-2">
                <Icon name="lucide:map-pin" class="size-4" />
                {iglesia.data.ciudad}
              </p>
              <h2 class="mt-2 text-2xl font-semibold group-hover:text-brand-600">{iglesia.data.nombre}</h2>
              {iglesia.data.pastores.length > 0 && (
                <p class="mt-3 flex items-start gap-2 text-stone-600">
                  <Icon name="lucide:user" class="mt-1 size-4 shrink-0" />
                  {iglesia.data.pastores.join(' · ')}
                </p>
              )}
              {iglesia.data.reuniones && (
                <p class="mt-1 flex items-start gap-2 text-stone-600">
                  <Icon name="lucide:clock" class="mt-1 size-4 shrink-0" />
                  {iglesia.data.reuniones}
                </p>
              )}
              <span class="mt-5 inline-flex items-center gap-2 font-semibold text-brand-700 group-hover:gap-3">
                Ver detalles <Icon name="lucide:arrow-right" class="size-4" />
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </Section>
</BaseLayout>
