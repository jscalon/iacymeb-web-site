---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import templo from '@/assets/templo.jpg';
import Icon from '@/components/Icon.astro';
import PageHeader from '@/components/PageHeader.astro';
import Section from '@/components/Section.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { obtenerNosotros } from '@/lib/contenido';
import { site } from '@/lib/site';

const nosotros = await obtenerNosotros();
const { Content } = await render(nosotros);
const { titulo, descripcion, mision, vision, creencias, identidadMision, declaracionFe } = nosotros.data;
const migas = [{ label: titulo, href: '/nosotros' }];
const iconosCreencias = ['lucide:cross', 'lucide:hand-heart', 'lucide:flame', 'lucide:crown'] as const;
---

<BaseLayout title={titulo} description={descripcion} migas={migas}>
  <PageHeader title={titulo} eyebrow={site.denominacion} intro={site.descripcion} migas={migas} />

  <Section tono="blanco">
    <div class="grid gap-6 md:grid-cols-2">
      <article class="rounded-3xl bg-brand-700 p-8 text-white lg:p-10">
        <Icon name="lucide:compass" class="size-9 text-accent-300" />
        <h2 class="mt-4 text-2xl font-semibold text-white">Nuestra misión</h2>
        <p class="mt-3 text-lg leading-relaxed text-brand-100">{mision}</p>
      </article>
      <article class="rounded-3xl bg-accent-100 p-8 lg:p-10">
        <Icon name="lucide:eye" class="size-9 text-accent-600" />
        <h2 class="mt-4 text-2xl font-semibold">Nuestra visión</h2>
        <p class="mt-3 text-lg leading-relaxed text-stone-700">{vision}</p>
      </article>
    </div>
  </Section>

  <Section eyebrow="Reseña histórica" title="Nuestra historia">
    <Image
      src={templo}
      alt={`Templo de ${site.nombre}`}
      widths={[700, 1400]}
      sizes="(min-width: 1024px) 896px, 100vw"
      class="mb-10 aspect-[2/1] w-full max-w-4xl rounded-3xl object-cover shadow-md"
    />
    <div class="prose-site">
      <Content />
    </div>
  </Section>

  <Section
    tono="blanco"
    eyebrow="Nuestra identidad"
    title="El evangelio cuádruple"
    intro="Como parte de la Alianza Cristiana y Misionera, nuestra identidad se centra en la persona y obra de Jesucristo."
  >
    <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        creencias.map((c, i) => (
          <li class="rounded-2xl border border-stone-200 bg-paper p-6">
            <Icon name={iconosCreencias[i % iconosCreencias.length]} class="size-8 text-accent-500" />
            <h3 class="mt-4 text-xl font-semibold">{c.titulo}</h3>
            <p class="mt-2 leading-relaxed text-stone-600">{c.texto}</p>
          </li>
        ))
      }
    </ul>
    {
      identidadMision && (
        <div class="mt-8 flex flex-col items-start gap-4 rounded-2xl bg-secondary-900 p-6 text-white sm:flex-row sm:items-center sm:p-8">
          <Icon name="lucide:globe" class="size-9 shrink-0 text-accent-300" />
          <div>
            <h3 class="text-xl font-semibold text-white">Tenemos una misión</h3>
            <p class="mt-1 leading-relaxed text-secondary-100">{identidadMision}</p>
          </div>
        </div>
      )
    }
  </Section>

  {
    declaracionFe.length > 0 && (
      <Section
        eyebrow="Doctrina"
        title="Declaración de fe de la Alianza Cristiana y Misionera"
        intro="La declaración doctrinal de la Alianza Cristiana y Misionera es la expresión de lo que los miembros de la Alianza creen, en su forma más sencilla y breve. Fue elaborada y aprobada por el Concilio General de la Alianza Cristiana y Misionera en los años 1965, 1966 y 1974."
      >
        <ol class="max-w-3xl space-y-4">
          {declaracionFe.map((articulo, i) => (
            <li class="flex gap-4 rounded-2xl border border-stone-200 bg-white p-6 shadow-xs">
              <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-brand-700 text-sm font-semibold text-white">
                {i + 1}
              </span>
              <p class="leading-relaxed text-stone-700">{articulo}</p>
            </li>
          ))}
        </ol>

        <div class="mt-10 max-w-3xl rounded-2xl border border-stone-200 bg-white p-6 sm:p-8">
          <p class="text-stone-700">
            Todo miembro de la Alianza Cristiana y Misionera debe conocer no solo la declaración doctrinal de su
            denominación sino también saber por qué es que creemos lo declarado en ella. El Apóstol Pedro nos exhorta:
          </p>
          <blockquote class="mt-4 border-l-4 border-accent-400 pl-5 font-serif text-lg text-brand-800 italic">
            “Estad siempre preparados para presentar defensa con mansedumbre y reverencia ante todo el que os demande
            razón de la esperanza que hay en vosotros”
            <footer class="mt-1 font-sans text-sm font-medium text-stone-500 not-italic">— 1 Pedro 3:15</footer>
          </blockquote>
        </div>
      </Section>
    )
  }

  <Section tono="arena">
    <div class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-center">
      <div>
        <h2 class="text-2xl font-semibold sm:text-3xl">Conoce a quienes sirven en la iglesia</h2>
        <p class="mt-2 text-lg text-stone-600">Nuestro equipo pastoral, la junta administrativa y los ministerios.</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href="/liderazgo" class="btn-secondary">Liderazgo</a>
        <a href="/ministerios" class="btn border border-brand-700 text-brand-700 hover:bg-brand-50">Ministerios</a>
      </div>
    </div>
  </Section>
</BaseLayout>
