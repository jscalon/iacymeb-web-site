---
import { render } from 'astro:content';
import Icon from '@/components/Icon.astro';
import PageHeader from '@/components/PageHeader.astro';
import Section from '@/components/Section.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { obtenerNosotros } from '@/lib/contenido';
import { site } from '@/lib/site';

const nosotros = await obtenerNosotros();
const { Content } = await render(nosotros);
const { titulo, descripcion, mision, vision, creencias } = nosotros.data;
const migas = [{ label: titulo, href: '/nosotros' }];
const iconosCreencias = ['lucide:cross', 'lucide:flame', 'lucide:hand-heart', 'lucide:crown'] as const;
---

<BaseLayout title={titulo} description={descripcion} migas={migas}>
  <PageHeader title={titulo} eyebrow={site.denominacion} intro={site.descripcion} migas={migas} />

  <Section tono="blanco">
    <div class="grid gap-6 md:grid-cols-2">
      <article class="rounded-3xl bg-brand-900 p-8 text-white lg:p-10">
        <Icon name="lucide:compass" class="size-9 text-accent-300" />
        <h2 class="mt-4 text-2xl font-semibold text-white">Nuestra misión</h2>
        <p class="mt-3 text-lg leading-relaxed text-brand-100">{mision}</p>
      </article>
      <article class="rounded-3xl bg-accent-100 p-8 lg:p-10">
        <Icon name="lucide:eye" class="size-9 text-accent-600" />
        <h2 class="mt-4 text-2xl font-semibold">Nuestra visión</h2>
        <p class="mt-3 text-lg leading-relaxed text-stone-700">{vision}</p>
      </article>
    </div>
  </Section>

  <Section eyebrow="Nuestra historia" title="Una iglesia de la Alianza">
    <div class="prose-site">
      <Content />
    </div>
  </Section>

  <Section
    tono="blanco"
    eyebrow="En qué creemos"
    title="El evangelio cuádruple"
    intro="Como parte de la Alianza Cristiana y Misionera, nuestra fe se centra en la persona de Jesucristo, revelada en las Sagradas Escrituras."
  >
    <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        creencias.map((c, i) => (
          <li class="rounded-2xl border border-stone-200 bg-paper p-6">
            <Icon name={iconosCreencias[i % iconosCreencias.length]} class="size-8 text-accent-500" />
            <h3 class="mt-4 text-xl font-semibold">{c.titulo}</h3>
            <p class="mt-2 leading-relaxed text-stone-600">{c.texto}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section tono="arena">
    <div class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-center">
      <div>
        <h2 class="text-2xl font-semibold sm:text-3xl">Conoce a quienes sirven en la iglesia</h2>
        <p class="mt-2 text-lg text-stone-600">Nuestro equipo pastoral, la junta administrativa y los ministerios.</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href="/equipo-pastoral" class="btn-secondary">Equipo pastoral</a>
        <a href="/ministerios" class="btn border border-brand-700 text-brand-700 hover:bg-brand-50">Ministerios</a>
      </div>
    </div>
  </Section>
</BaseLayout>
