---
import Icon from '@/components/Icon.astro';
import Logo from '@/components/Logo.astro';
import { navegacion, rutaLimpia, site } from '@/lib/site';

const actual = rutaLimpia(Astro.url);
const esActivo = (href: string) => (href === '/' ? actual === '/' : actual === href || actual.startsWith(`${href}/`));
const grupoActivo = (item: (typeof navegacion)[number]) =>
  esActivo(item.href) || (item.children ?? []).some((hijo) => esActivo(hijo.href));
---

<header class="sticky top-0 z-40 border-b border-stone-200/80 bg-white/90 backdrop-blur">
  <div class="container-site flex h-16 items-center justify-between gap-4 lg:h-20">
    <a href="/" class="flex items-center gap-3" aria-label={`${site.nombreCorto}, ir al inicio`}>
      <Logo class="size-10 shrink-0 lg:size-11" />
      <span class="leading-tight">
        <span class="block text-[0.65rem] font-semibold tracking-widest text-stone-500 uppercase">
          {site.denominacion}
        </span>
        <span class="block font-serif text-lg font-semibold text-brand-900">{site.nombreCorto}</span>
      </span>
    </a>

    <nav aria-label="Principal" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          navegacion.map((item) =>
            item.children ? (
              <li class="group relative">
                <a
                  href={item.href}
                  class:list={[
                    'flex items-center gap-1 rounded-full px-3 py-2 text-sm font-medium transition-colors hover:text-brand-600',
                    grupoActivo(item) ? 'text-brand-700' : 'text-stone-700',
                  ]}
                  aria-current={esActivo(item.href) ? 'page' : undefined}
                >
                  {item.label}
                  <Icon name="lucide:chevron-down" class="size-4 transition-transform group-hover:rotate-180" />
                </a>
                <ul class="invisible absolute top-full left-0 min-w-52 translate-y-1 rounded-xl border border-stone-200 bg-white p-2 opacity-0 shadow-lg transition group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100">
                  {item.children.map((hijo) => (
                    <li>
                      <a
                        href={hijo.href}
                        class:list={[
                          'block rounded-lg px-3 py-2 text-sm hover:bg-brand-50 hover:text-brand-700',
                          esActivo(hijo.href) ? 'font-semibold text-brand-700' : 'text-stone-700',
                        ]}
                        aria-current={esActivo(hijo.href) ? 'page' : undefined}
                      >
                        {hijo.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : item.href === '/contacto' ? (
              <li class="ml-2">
                <a href={item.href} class="btn-secondary" aria-current={esActivo(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ) : (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    'rounded-full px-3 py-2 text-sm font-medium transition-colors hover:text-brand-600',
                    esActivo(item.href) ? 'text-brand-700' : 'text-stone-700',
                  ]}
                  aria-current={esActivo(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </nav>

    <details class="group/menu lg:hidden">
      <summary
        class="flex size-10 cursor-pointer list-none items-center justify-center rounded-full text-brand-900 hover:bg-stone-100 [&::-webkit-details-marker]:hidden"
        aria-label="Abrir menú"
      >
        <Icon name="lucide:menu" class="size-6 group-open/menu:hidden" />
        <Icon name="lucide:x" class="hidden size-6 group-open/menu:block" />
      </summary>
      <nav
        aria-label="Principal (móvil)"
        class="absolute inset-x-0 top-full max-h-[calc(100dvh-4rem)] overflow-y-auto border-b border-stone-200 bg-white shadow-lg"
      >
        <ul class="container-site space-y-1 py-4">
          {
            navegacion.map((item) => (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    'block rounded-lg px-3 py-2.5 font-medium',
                    esActivo(item.href) ? 'bg-brand-50 text-brand-700' : 'text-stone-800',
                  ]}
                  aria-current={esActivo(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
                {item.children && (
                  <ul class="ml-3 border-l border-stone-200 pl-3">
                    {item.children
                      .filter((hijo) => hijo.href !== item.href)
                      .map((hijo) => (
                        <li>
                          <a
                            href={hijo.href}
                            class:list={[
                              'block rounded-lg px-3 py-2 text-sm',
                              esActivo(hijo.href) ? 'font-semibold text-brand-700' : 'text-stone-600',
                            ]}
                            aria-current={esActivo(hijo.href) ? 'page' : undefined}
                          >
                            {hijo.label}
                          </a>
                        </li>
                      ))}
                  </ul>
                )}
              </li>
            ))
          }
        </ul>
      </nav>
    </details>
  </div>
</header>
