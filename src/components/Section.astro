---
interface Props {
  title?: string;
  eyebrow?: string;
  intro?: string;
  id?: string;
  tono?: 'claro' | 'arena' | 'blanco';
  centrado?: boolean;
  class?: string;
}

const { title, eyebrow, intro, id, tono = 'claro', centrado = false, class: className } = Astro.props;
const fondos = { claro: 'bg-paper', arena: 'bg-sand', blanco: 'bg-white' };
---

<section id={id} class:list={[fondos[tono], 'py-16 lg:py-24', className]}>
  <div class="container-site">
    {
      (title || eyebrow || intro) && (
        <header class:list={['mb-10 max-w-2xl lg:mb-14', centrado && 'mx-auto text-center']}>
          {eyebrow && <p class="eyebrow mb-3">{eyebrow}</p>}
          {title && <h2 class="text-3xl font-semibold sm:text-4xl">{title}</h2>}
          {intro && <p class="mt-4 text-lg leading-relaxed text-stone-600">{intro}</p>}
        </header>
      )
    }
    <slot />
  </div>
</section>
