---
import type { CollectionEntry } from 'astro:content';
import Icon from '@/components/Icon.astro';

interface Props {
  reunion: CollectionEntry<'reuniones'>;
}

const { nombre, dia, hora, descripcion, frecuencia } = Astro.props.reunion.data;
---

<article class="flex h-full flex-col rounded-2xl border border-stone-200 bg-white p-6 shadow-sm">
  <p class="eyebrow">{dia}</p>
  <h3 class="mt-2 text-xl font-semibold">{nombre}</h3>
  <p class="mt-3 flex-1 leading-relaxed text-stone-600">{descripcion}</p>
  <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm font-medium text-brand-700">
    <span class="flex items-center gap-1.5">
      <Icon name="lucide:clock" class="size-4" />
      {hora}
    </span>
    {
      frecuencia && (
        <span class="flex items-center gap-1.5">
          <Icon name="lucide:calendar-days" class="size-4" />
          {frecuencia}
        </span>
      )
    }
  </div>
</article>
