---
import { Image } from 'astro:assets';
import logo from '@/assets/logo.png';

interface Props {
  class?: string;
}
const { class: className = 'size-10' } = Astro.props;
---

<Image
  src={logo}
  alt=""
  widths={[48, 96, 192]}
  sizes="48px"
  class:list={['object-contain', className]}
  aria-hidden="true"
/>
